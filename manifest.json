{
  "manifestVersion": 5,
  "id": "com.crispenstanbach.phrase-selects",
  "name": "Phrase Selects",
  "version": "0.1.10",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "phrase-selects-panel",
      "label": {
        "default": "Phrase Selects"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 760
      }
    }
  ]
}
